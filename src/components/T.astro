---
// Bilingual text. Renders English; the language toggle swaps in data-ar.
// <T v={{ en, ar }} />  or  <T k="nav.about" />  (k = key in src/i18n/ui.ts)
import { ui, type Text, type UiKey } from '../i18n/ui';

interface Props { v?: Text; k?: UiKey; as?: string; class?: string; [attr: string]: unknown }
const { v, k, as = 'span', class: cls, ...rest } = Astro.props;
const text = v ?? (k ? ui[k] : undefined);
if (!text) throw new Error(`T: missing text for ${k ?? 'value'}`);
const Tag = as as any;
---
<Tag class={cls} data-ar={text.ar} {...rest} set:html={text.en} />
