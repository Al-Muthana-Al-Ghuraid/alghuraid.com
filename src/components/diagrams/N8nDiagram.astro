---
// Self-drawing architecture diagram for the n8n project. Animates when scrolled into view (src/scripts/site.ts).
const L = {
  browser: { en: 'Browser', ar: 'المتصفح' },
  me: { en: 'me · laptop/phone', ar: 'أنا · حاسوب أو جوال' },
  pin: { en: 'email PIN · 1 user', ar: 'رمز عبر البريد · مستخدم واحد' },
  nightly: { en: 'nightly · 14-day retention', ar: 'كل ليلة · حفظ لمدة 14 يومًا' },
  tunnel: { en: 'outbound-only tunnel', ar: 'نفق صادر فقط' },
  ports: { en: '0 open inbound ports', ar: 'لا منافذ واردة مفتوحة' },
};
---
<div class="diagram-wrap">
<svg class="diagram" viewBox="0 0 960 380" role="img" aria-label="Architecture: browser to Cloudflare edge to Cloudflare Access, through an outbound tunnel into Docker on Oracle Cloud running cloudflared and n8n, which calls Apify, OpenAI and Google APIs; cron makes nightly backups.">
  <defs><marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0 10 5 0 10z" fill="var(--blue)"/></marker></defs>
  <g class="dg" style="--s:5"><rect x="530" y="40" width="262" height="300" rx="16" class="grp"/><text x="546" y="64" class="grp-t">ORACLE CLOUD · UBUNTU · ARM64</text>
    <rect x="550" y="80" width="222" height="182" rx="12" class="grp grp2"/><text x="564" y="100" class="grp-t">docker compose</text></g>
  <path class="edge" style="--s:1" d="M150 196H186" marker-end="url(#arr)"/>
  <path class="edge" style="--s:3" d="M320 196H356" marker-end="url(#arr)"/>
  <path class="edge dashed-edge" style="--s:6" d="M490 196C520 196 535 135 566 135" marker-end="url(#arr)"/>
  <path class="edge" style="--s:8" d="M661 157V184" marker-end="url(#arr)"/>
  <path class="edge" style="--s:10" d="M752 206C790 206 792 98 816 98" marker-end="url(#arr)"/>
  <path class="edge" style="--s:10" d="M752 206H816" marker-end="url(#arr)"/>
  <path class="edge" style="--s:10" d="M752 206C790 206 792 314 816 314" marker-end="url(#arr)"/>
  <path class="edge" style="--s:12" d="M661 228V280" marker-end="url(#arr)"/>
  <text class="edge-t dg" style="--s:7" x="420" y="128" data-ar={L.tunnel.ar}>{L.tunnel.en}</text>
  <text class="edge-t dg" style="--s:7" x="420" y="144" data-ar={L.ports.ar}>{L.ports.en}</text>
  <circle r="5" class="packet"><animateMotion dur="3.2s" repeatCount="indefinite" begin="indefinite" path="M85 196H490C520 196 535 135 566 135H661V206H752H880"/></circle>
  <g class="dg" style="--s:0"><rect x="20" y="168" width="130" height="56" rx="12" class="node"/><text x="85" y="192" class="n-t" data-ar={L.browser.ar}>{L.browser.en}</text><text x="85" y="210" class="n-s" data-ar={L.me.ar}>{L.me.en}</text></g>
  <g class="dg" style="--s:2"><rect x="190" y="168" width="130" height="56" rx="12" class="node"/><text x="255" y="192" class="n-t">Cloudflare</text><text x="255" y="210" class="n-s">DNS · TLS · edge</text></g>
  <g class="dg" style="--s:4"><rect x="360" y="168" width="130" height="56" rx="12" class="node hl"/><text x="425" y="192" class="n-t">CF Access</text><text x="425" y="210" class="n-s" data-ar={L.pin.ar}>{L.pin.en}</text></g>
  <g class="dg" style="--s:7"><rect x="570" y="113" width="182" height="44" rx="10" class="node"/><text x="661" y="140" class="n-t">cloudflared</text></g>
  <g class="dg" style="--s:9"><rect x="570" y="184" width="182" height="44" rx="10" class="node hl"/><text x="661" y="211" class="n-t">n8n · SQLite</text></g>
  <g class="dg" style="--s:13"><rect x="570" y="280" width="182" height="44" rx="10" class="node"/><text x="661" y="300" class="n-t">cron · backup.sh</text><text x="661" y="315" class="n-s" data-ar={L.nightly.ar}>{L.nightly.en}</text></g>
  <g class="dg" style="--s:11"><rect x="820" y="76" width="122" height="44" rx="10" class="node"/><text x="881" y="103" class="n-t">Apify</text></g>
  <g class="dg" style="--s:11"><rect x="820" y="184" width="122" height="44" rx="10" class="node"/><text x="881" y="211" class="n-t">OpenAI</text></g>
  <g class="dg" style="--s:11"><rect x="820" y="292" width="122" height="44" rx="10" class="node"/><text x="881" y="319" class="n-t">Google APIs</text></g>
</svg>
</div>
