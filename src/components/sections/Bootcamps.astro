---
import T from '../T.astro';
import Icon from '../Icon.astro';
import { range } from '../../i18n/ui';
import type { Site } from '../../lib/data';

const { site } = Astro.props as { site: Site };
---
{site.bootcamps.length > 0 && (
<section id="bootcamps">
  <div class="wrap">
    <div class="sec-head reveal"><div class="sec-label">05 // bootcamps</div><T as="h2" k="bo.h" /><T as="p" k="bo.sub" />
      <div class="stat-row">
        {site.totalHours > 0 && <div class="stat"><b class="count" data-to={site.totalHours}>{site.totalHours.toLocaleString('en')}</b><span>+</span><T as="small" k="bo.s1" /></div>}
        <div class="stat"><b class="count" data-to={site.bootcamps.length}>{site.bootcamps.length}</b><T as="small" k="bo.s2" /></div>
        {site.capstones > 0 && <div class="stat"><b class="count" data-to={site.capstones}>{site.capstones}</b><T as="small" k="bo.s3" /></div>}
      </div>
    </div>
    <div class="boot-grid">
      {site.bootcamps.map(({ data: b }) => {
        const when = range(b.start, b.end);
        const cap = b.capstone ? site.projectById.get(b.capstone) : undefined;
        return (
          <article class="card boot reveal">
            <div class="boot-head">
              <div>
                <div class="p-meta"><span>{b.provider}</span>{b.mode && <T k={`mode.${b.mode}`} />}{when && <T v={when} />}</div>
                <h3 style="margin-top:6px">{b.name}</h3>
              </div>
              {b.hours && <div class="hours">{b.hours}<T as="small" k="u.hrs" /></div>}
            </div>
            {b.selective && <span class="status sel">◆ <T v={b.selective} /></span>}
            <T as="p" v={b.summary} />
            <div class="chips">{b.skills.map((s) => <span class="chip">{s}</span>)}</div>
            {cap && (
              <a href={`/projects/${cap.id}/`} class="capstone">
                <div><T as="small" k="bo.cap" /><T v={cap.data.title} /></div><Icon name="arrow" />
              </a>
            )}
          </article>
        );
      })}
    </div>
  </div>
</section>
)}
