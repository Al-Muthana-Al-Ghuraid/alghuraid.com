---
import T from '../T.astro';
import Icon from '../Icon.astro';
import type { Site } from '../../lib/data';

const { site } = Astro.props as { site: Site };
const { settings: s, certifications } = site;
const edu = s.education;
const line = (prog: string) => certifications
  .filter((c) => c.data.status !== 'expired')
  .map((c) => { const n = c.data.short ?? c.data.badge; return c.data.status === 'in-progress' ? `${n} <span class="soon">${prog}</span>` : n; })
  .join(' · ');
const certLine = { en: line('in progress'), ar: line('قيد التحضير') };
---
<section id="about">
  <div class="wrap">
    <div class="sec-head reveal"><div class="sec-label">01 // about</div><T as="h2" k="about.h" /></div>
    <div class="about-grid">
      <div class="about-text reveal">
        {s.about.map((p) => <T as="p" v={p} />)}
      </div>
      <div class="facts">
        <div class="card fact reveal"><div class="ico"><Icon name="edu" /></div>
          <div><T as="small" k="f.edu" /><T v={{ en: `${edu.degree.en}, ${edu.school.en} · ${edu.years}`, ar: `${edu.degree.ar}، ${edu.school.ar} · ${edu.years}` }} /></div></div>
        <div class="card fact reveal"><div class="ico"><Icon name="pin" /></div>
          <div><T as="small" k="f.loc" /><T v={{ en: `${s.location.en} · ${s.relocate.en}`, ar: `${s.location.ar} · ${s.relocate.ar}` }} /></div></div>
        <div class="card fact reveal"><div class="ico"><Icon name="lang" /></div>
          <div><T as="small" k="f.lang" /><T v={s.languages} /></div></div>
        {certifications.length > 0 && (
          <div class="card fact reveal"><div class="ico"><Icon name="award" /></div>
            <div><T as="small" k="f.cert" /><T v={certLine} /></div></div>
        )}
      </div>
    </div>
  </div>
</section>
