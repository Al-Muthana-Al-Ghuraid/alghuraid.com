---
import T from '../T.astro';
import Icon from '../Icon.astro';
import { ui } from '../../i18n/ui';
import type { Site } from '../../lib/data';

const { site } = Astro.props as { site: Site };
const s = site.settings;
const l = s.links;
const tiles = [
  { href: l.linkedin, icon: 'linkedin', label: { en: 'LinkedIn', ar: 'LinkedIn' } },
  { href: l.github, icon: 'github', label: { en: 'GitHub', ar: 'GitHub' } },
  { href: `https://wa.me/${l.whatsapp}`, icon: 'chat', label: { en: 'WhatsApp', ar: 'واتساب' } },
  { href: l.cv, icon: 'download', label: ui['nav.cv'], download: true },
] as const;
const endpoint = s.contactFormEndpoint;
---
<section id="contact">
  <div class="wrap">
    <div class="sec-head reveal"><div class="sec-label">06 // contact</div><T as="h2" k="co.h" /><T as="p" k="co.sub" /></div>
    <div class="contact-grid">
      <aside class="card contact-panel reveal">
        <div class="avail"><span class="pulse-dot"></span><T k="co.avail" /> <T class="avail-v" v={s.availability} /></div>
        <ul class="meta-list">
          <li><Icon name="pin" /><T v={{ en: `${s.location.en} · ${s.relocate.en}`, ar: `${s.location.ar} · ${s.relocate.ar}` }} /></li>
          <li><Icon name="bolt" /><T k="co.reply" /></li>
        </ul>
        <div class="email-row">
          <a href={`mailto:${l.email}`} class="email-link"><Icon name="mail" /><span class="mono">{l.email}</span></a>
          <button class="btn btn-ghost btn-sm copy-btn" data-copy={l.email} type="button"><T k="co.copy" class="copy-label" /><T k="co.copied" class="copied-label" /></button>
        </div>
        <div class="tiles">
          {tiles.map((t) => (
            <a class="tile" href={t.href} target={t.href.startsWith('http') ? '_blank' : undefined} rel="noopener" download={'download' in t ? true : undefined}>
              <Icon name={t.icon} /><T v={t.label} />
            </a>
          ))}
        </div>
      </aside>

      <form class="card contact-form reveal" id="contactForm" action={endpoint || `mailto:${l.email}`} method="post" data-endpoint={endpoint}>
        {s.contactFormKey && <input type="hidden" name="access_key" value={s.contactFormKey}>}
        <input type="hidden" name="subject" value="New message from alghuraid.com">
        <input type="hidden" name="from_name" value="alghuraid.com contact form">
        <T as="h3" class="form-title" k="co.formTitle" />
        <label class="field"><input name="name" required autocomplete="name" placeholder=" "><T k="fo.name" /></label>
        <label class="field"><input name="email" type="email" required autocomplete="email" placeholder=" "><T k="fo.email" /></label>
        <label class="field"><textarea name="message" required placeholder=" "></textarea><T k="fo.msg" /></label>
        <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
        <button class="btn btn-primary send-btn" type="submit"><T k="fo.send" /><Icon name="send" class="plane" /></button>
        <T as="p" class="form-msg" k="fo.sent" hidden data-ok />
        <T as="p" class="form-msg err" k="fo.err" hidden data-err />
      </form>
    </div>
  </div>
</section>
