---
import '../styles/global.css';
import T from '../components/T.astro';
import Icon from '../components/Icon.astro';
import settings from '../content/settings.json';

interface Props { title?: string; description?: string; home?: boolean; image?: string }
const { title, description, home = false, image = '/media/og.png' } = Astro.props;
const fullTitle = title ? `${title} · ${settings.name.en}` : `${settings.name.en} · ${settings.role.en}`;
const desc = description ?? settings.lead.en;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
// On sub-pages the nav links point back to the home page sections.
const h = home ? '' : '/';
---
<!doctype html>
<html lang="en" dir="ltr" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={desc}>
  <link rel="canonical" href={canonical}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="sitemap" href="/sitemap.xml">
  <meta property="og:type" content="website">
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={desc}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#05070f">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet">
  <!-- apply saved theme/language before first paint (no flash) -->
  <script is:inline>
    try {
      // ?lang=ar / ?lang=en in the link wins over the saved choice (handy for sharing the Arabic version)
      const q = new URLSearchParams(location.search).get('lang');
      const d = document.documentElement, t = localStorage.getItem('theme'), l = q || localStorage.getItem('lang');
      if (t) d.dataset.theme = t;
      if (l === 'ar') { d.lang = 'ar'; d.dir = 'rtl'; }
    } catch (e) {}
  </script>
</head>
<body>
  <div class="bg-grid"></div><div class="glow a"></div><div class="glow b"></div>

  <nav>
    <div class="wrap">
      <a href={home ? '#top' : '/'} class="logo">&lt;<b>alghuraid</b> /&gt;</a>
      <div class="nav-links" id="navLinks">
        <a href={`${h}#about`}><T k="nav.about" /></a>
        <a href={`${h}#skills`}><T k="nav.skills" /></a>
        <a href={`${h}#projects`}><T k="nav.projects" /></a>
        <a href={`${h}#certs`}><T k="nav.certs" /></a>
        <a href={`${h}#bootcamps`}><T k="nav.boot" /></a>
        <a href={`${h}#contact`}><T k="nav.contact" /></a>
      </div>
      <div class="nav-tools">
        <button class="icon-btn lang-btn" id="langBtn" aria-label="Switch language / تغيير اللغة"><span class="on">EN</span>|<span>ع</span></button>
        <button class="icon-btn" id="themeBtn" aria-label="Toggle theme"><Icon name="sun" class="ico-sun" /><Icon name="moon" class="ico-moon" /></button>
        <a href={settings.links.cv} class="btn btn-primary btn-sm nav-cv" download><Icon name="download" /><T k="nav.cv" /></a>
        <button class="icon-btn menu-btn" id="menuBtn" aria-label="Menu"><Icon name="menu" /></button>
      </div>
    </div>
  </nav>

  <slot />

  <footer><div class="wrap"><span>© {new Date().getFullYear()} <T v={settings.name} /></span><T k="ft.built" class="mono" /></div></footer>

  <script>import '../scripts/site';</script>
</body>
</html>
