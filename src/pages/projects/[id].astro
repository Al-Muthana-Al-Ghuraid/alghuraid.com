---
// One page per project, generated from src/content/projects/*.yaml
import Base from '../../layouts/Base.astro';
import T from '../../components/T.astro';
import Icon from '../../components/Icon.astro';
import CodeCover from '../../components/CodeCover.astro';
import N8nDiagram from '../../components/diagrams/N8nDiagram.astro';
import { loadSite } from '../../lib/data';

export async function getStaticPaths() {
  const { projects } = await loadSite();
  return projects.map((p) => ({ params: { id: p.id }, props: { id: p.id } }));
}

const site = await loadSite();
const p = site.projectById.get(Astro.props.id)!;
const d = p.data, cs = d.caseStudy;
const diagrams = { n8n: N8nDiagram } as const;
const Diagram = cs && cs.diagram !== 'none' ? diagrams[cs.diagram] : null;
const others = site.projects.filter((x) => x.id !== p.id).slice(0, 2);
let n = 0; const num = () => String(++n).padStart(2, '0');
---
<Base title={d.title.en} description={d.summary.en} image={d.cover && !d.cover.endsWith('.webp') ? d.cover : undefined}>
  <main class="cs-page">
    <div class="wrap">
      <a href="/#projects" class="back reveal"><T k="cs.back" /></a>
      <header class="cs-hero reveal">
        <div class="p-meta">{d.org && <span>{d.org}</span>}<span>{d.year}</span></div>
        <T as="h1" v={d.title} />
        <T as="p" class="cs-intro" v={cs?.intro ?? d.summary} />
        <div class="impact"><Icon name="trend" /><T v={d.impact} /></div>
        <div class="p-actions">
          {d.github && <a href={d.github} target="_blank" rel="noopener" class="btn btn-primary btn-sm"><Icon name="github" />GitHub</a>}
          {!d.github && d.githubSoon && <span class="btn btn-ghost btn-sm" aria-disabled="true">GitHub <T k="btn.soon" class="soon" /></span>}
          {d.live && <a href={d.live} target="_blank" rel="noopener" class="btn btn-ghost btn-sm"><Icon name="external" /><T k="btn.live" /></a>}
        </div>
      </header>

      {cs && cs.stats.length > 0 && (
        <div class="cs-stats reveal">{cs.stats.map((s) => <div><b>{s.value}</b><T as="small" v={s.label} /></div>)}</div>
      )}

      {Diagram && (
        <section class="cs-sec reveal">
          <div class="cs-h"><span class="mono">{num()}</span> <T k="cs.arch" /><button class="btn btn-ghost btn-sm replay" style="margin-inline-start:auto">↻ <T k="cs.replay" /></button></div>
          <Diagram />
        </section>
      )}

      {cs?.problem && <section class="cs-sec reveal"><div class="cs-h"><span class="mono">{num()}</span> <T k="cs.problem" /></div><T as="p" class="cs-text" v={cs.problem} /></section>}
      {cs && cs.built.length > 0 && <section class="cs-sec reveal"><div class="cs-h"><span class="mono">{num()}</span> <T k="cs.built" /></div><ul class="qv-list cs-list">{cs.built.map((b) => <T as="li" v={b} />)}</ul></section>}
      {cs && cs.decisions.length > 0 && <section class="cs-sec reveal"><div class="cs-h"><span class="mono">{num()}</span> <T k="cs.decisions" /></div><ul class="qv-list cs-list">{cs.decisions.map((b) => <T as="li" v={b} />)}</ul></section>}
      {cs && cs.challenges.length > 0 && <section class="cs-sec reveal"><div class="cs-h"><span class="mono">{num()}</span> <T k="cs.challenges" /></div><ul class="qv-list cs-list">{cs.challenges.map((b) => <T as="li" v={b} />)}</ul></section>}
      {cs && cs.results.length > 0 && <section class="cs-sec reveal"><div class="cs-h"><span class="mono">{num()}</span> <T k="cs.results" /></div><ul class="qv-list cs-list">{cs.results.map((b) => <T as="li" v={b} />)}</ul></section>}

      <section class="cs-sec reveal"><div class="cs-h"><span class="mono">{num()}</span> <T k="cs.stack" /></div><div class="chips">{d.tags.map((t) => <span class="chip">{t}</span>)}</div></section>

      {cs && cs.screenshots.length > 0 ? (
        <section class="cs-sec reveal"><div class="cs-h"><span class="mono">{num()}</span> <T k="cs.shots" /></div>
          <div class="shots">{cs.screenshots.map((s) => <figure class="card shot"><img src={s.src} alt={s.caption.en} loading="lazy"><T as="figcaption" v={s.caption} /></figure>)}</div>
        </section>
      ) : !d.cover && d.codeCover && <div class="cs-sec reveal card" style="padding:0;overflow:hidden"><CodeCover file={d.codeCover.file} code={d.codeCover.code} /></div>}

      {others.length > 0 && (
        <section class="cs-sec reveal"><div class="cs-h"><T k="pr.h" /></div>
          <div class="more">{others.map((o) => <a class="card more-card" href={`/projects/${o.id}/`}><T as="h3" v={o.data.title} /><T as="p" v={o.data.impact} /><Icon name="arrow" class="go arrow-flip" /></a>)}</div>
        </section>
      )}
    </div>
  </main>
</Base>
